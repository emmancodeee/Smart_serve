# Server Configuration
PORT=3000
NODE_ENV=development
FORCE_HTTPS=false
TRUST_PROXY_HOPS=1
MONGO_RETRY_DELAY_MS=5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/PhinmaServeDB

# Security
JWT_SECRET=your-super-secret-jwt-key-here

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
# Optional SMTP overrides. Gmail uses smtp.gmail.com:587 by default.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
# SMTP_USER, SMTP_PASSWORD, SMTP_HOST, SMTP_PORT, SMTP_SECURE, and SMTP_FROM
# are also accepted for deployment platforms that provide SMTP_* variables.

# Logging
LOG_LEVEL=DEBUG

# AI Services
OPENAI_API_KEY=your-openai-api-key
OPENAI_SCHEDULER_MODEL=stepfun/step-3.5-flash:free
OPEN_ROUTER_API_KEY=your-open-router-api-key
OPENROUTER_SITE_URL=

OPENROUTER_SITE_NAME=Phinma Serve

# Admin Configuration
ALLOW_ADMIN_SEED=false
ADMIN1_PASSWORD=replace-with-a-unique-strong-password
ADMIN2_PASSWORD=replace-with-a-different-unique-strong-password
